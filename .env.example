# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.

# Random long string used to sign session cookies. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secretkey

# Where the SQLite database file lives (default is fine for local dev)
DATABASE_URL=sqlite:///bhai.db

# Which AI backend to use: "groq" or "ollama"
LLM_PROVIDER=groq

# --- Groq settings (free tier: https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

